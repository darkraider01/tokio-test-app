--- /dev/null
+++ b/tokio/src/runtime/ground_truth_probes.rs
@@ -0,0 +1,156 @@
+// TEMPORARY GROUND TRUTH INSTRUMENTATION FOR OBSERVABILITY INVESTIGATION
+// NOT FOR PRODUCTION USE
+
+#![allow(missing_docs)]
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Mutex;
+use std::time::Instant;
+
+#[derive(Clone, Debug)]
+pub enum ProbeEvent {
+    IoReadinessObserved {
+        t_ns: u64,
+        token: usize,
+        ready: usize,
+        count: usize,
+    },
+    ResourceWakeDispatched {
+        t_ns: u64,
+        ready: usize,
+    },
+    TaskWakeByVal {
+        t_ns: u64,
+        task_id: u64,
+        submitted: bool,
+    },
+    TaskWakeByRef {
+        t_ns: u64,
+        task_id: u64,
+        submitted: bool,
+    },
+    TaskScheduled {
+        t_ns: u64,
+        task_id: u64,
+        is_local: bool,
+    },
+    SchedulerWakeDecision {
+        t_ns: u64,
+        task_id: Option<u64>,
+        caller: &'static str,
+        target_worker: Option<usize>,
+        num_searching: usize,
+        num_unparked: usize,
+        total_workers: usize,
+    },
+    WorkerUnparkRequested {
+        t_ns: u64,
+        target_worker: usize,
+        prev_state: &'static str,
+    },
+    WorkerUnparkDispatchBegin {
+        t_ns: u64,
+        target_worker: usize,
+        mechanism: &'static str,
+    },
+    WorkerParkWaitBegin {
+        t_ns: u64,
+        worker_id: usize,
+        kind: &'static str,
+    },
+    WorkerParkWaitEnd {
+        t_ns: u64,
+        worker_id: usize,
+        kind: &'static str,
+        state_after: &'static str,
+    },
+    WorkerResumed {
+        t_ns: u64,
+        worker_id: usize,
+    },
+    WorkerPollStart {
+        t_ns: u64,
+        worker_id: usize,
+        task_id: u64,
+    },
+    WorkerPollEnd {
+        t_ns: u64,
+        worker_id: usize,
+        task_id: u64,
+    },
+    ExternalIoStimulus {
+        t_ns: u64,
+        phase: &'static str,
+        details: &'static str,
+    },
+}
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static BASE_TIME: Mutex<Option<Instant>> = Mutex::new(None);
+static EVENTS: Mutex<Vec<ProbeEvent>> = Mutex::new(Vec::new());
+
+thread_local! {
+    static CURRENT_TASK_ID: std::cell::Cell<Option<u64>> = const { std::cell::Cell::new(None) };
+}
+
+pub fn set_current_task_id(id: Option<u64>) {
+    CURRENT_TASK_ID.with(|c| c.set(id));
+}
+
+pub fn current_task_id() -> Option<u64> {
+    CURRENT_TASK_ID.with(|c| c.get())
+}
+
+pub fn enable() {
+    let mut base = BASE_TIME.lock().unwrap();
+    if base.is_none() {
+        *base = Some(Instant::now());
+    }
+    EVENTS.lock().unwrap().clear();
+    ENABLED.store(true, Ordering::SeqCst);
+}
+
+pub fn disable() {
+    ENABLED.store(false, Ordering::SeqCst);
+}
+
+pub fn reset_base_time() {
+    let mut base = BASE_TIME.lock().unwrap();
+    *base = Some(Instant::now());
+    EVENTS.lock().unwrap().clear();
+}
+
+pub fn now_ns() -> u64 {
+    let base = BASE_TIME.lock().unwrap();
+    match *base {
+        Some(b) => b.elapsed().as_nanos() as u64,
+        None => 0,
+    }
+}
+
+pub fn is_enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+pub fn record(event: ProbeEvent) {
+    if !is_enabled() {
+        return;
+    }
+    let mut events = EVENTS.lock().unwrap();
+    events.push(event);
+}
+
+pub fn record_external_stimulus(phase: &'static str, details: &'static str) {
+    if is_enabled() {
+        record(ProbeEvent::ExternalIoStimulus {
+            t_ns: now_ns(),
+            phase,
+            details,
+        });
+    }
+}
+
+pub fn take_events() -> Vec<ProbeEvent> {
+    let mut events = EVENTS.lock().unwrap();
+    std::mem::take(&mut *events)
+}
