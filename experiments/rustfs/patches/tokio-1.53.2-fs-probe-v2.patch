+//! No-op counterpart of [`crate::fs_probe`] used when the `rustfs_fs_probe`
+//! cfg is absent, so instrumentation call sites compile unchanged. Every
+//! function is a zero-cost stub.
+
+use std::future::Future;
+
+pub const OP_NONE: u64 = 0;
+
+pub fn record(_kind: u8, _step: u32, _a: u64) {}
+
+pub fn flush_to_env() {}
+
+pub fn propagate_op<F: Future>(future: F) -> F {
+    future
+}
+
+#[allow(dead_code)]
+pub(crate) fn spawn_submit(_id: u64) {}
+
+#[allow(dead_code)]
+pub(crate) fn job_start(_id: u64) {}
+
+#[allow(dead_code)]
+pub(crate) fn job_end(_id: u64) {}
+
+#[allow(dead_code)]
+pub(crate) fn job_complete() {}
+
+#[allow(dead_code)]
+pub(crate) fn join_ready(_id: u64) {}
