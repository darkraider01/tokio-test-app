+// Diagnostic blocking-pool boundary probe; see the module docs.
+//
+// The probe reads raw clocks through `libc`, which tokio declares as an
+// optional dependency. Feature unification gives the runtime units the
+// `libc` feature (via `net`/`process`/`signal`), but the build-dependency
+// units tokio is compiled into do not enable it; those units fall back to
+// the stub, so build scripts record nothing (the probe only matters in the
+// server binary, whose tokio units always carry `libc`).
+#[cfg(all(rustfs_fs_probe, feature = "libc"))]
+#[path = "fs_probe.rs"]
+pub mod fs_probe;
+#[cfg(not(all(rustfs_fs_probe, feature = "libc")))]
+#[path = "fs_probe_stub.rs"]
+pub mod fs_probe;
+
 pub mod io;
 pub mod net;
 
