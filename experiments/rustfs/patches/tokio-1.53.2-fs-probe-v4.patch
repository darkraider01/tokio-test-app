+//! Standalone harness for the fs-probe record ring.
+//!
+//! Includes `src/fs_probe_ring.rs` verbatim — the same file Tokio compiles
+//! under `rustfs_fs_probe` — so `cargo test` here exercises exactly the
+//! shipped writer/flush code (slot claims, the admission gate, drains,
+//! repeated flushes, capacity stop) without building Tokio itself.
+//!
+//! Run from the probe working copy:
+//!
+//! ```sh
+//! CARGO_TARGET_DIR=<scratch> cargo test --offline \
+//!   --manifest-path fs-probe-ring-tests/Cargo.toml
+//! ```
+
+// The ring module's fields are all read by the probe's flush path, which
+// this harness deliberately does not compile.
+#![allow(dead_code)]
+
+#[path = "../../src/fs_probe_ring.rs"]
+mod fs_probe_ring;
