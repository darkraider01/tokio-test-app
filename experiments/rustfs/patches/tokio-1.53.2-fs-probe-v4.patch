+//! Concurrent record ring with a flush admission gate for the fs probe.
+//!
+//! `std`-only on purpose: the same file is compiled inside Tokio (declared
+//! from `lib.rs` next to `fs_probe.rs`, gated by `rustfs_fs_probe`) and
+//! standalone by the `fs-probe-ring-tests` crate, so the concurrency tests
+//! at the bottom exercise exactly the code the probe ships.
+//!
+//! # Why slot exclusivity alone is not enough
+//!
+//! Each record index below `N` is claimed exactly once (`write.fetch_add`),
+//! recording stops at capacity, and the ring never wraps, so two writers
+//! never store to the same slot. That invariant only rules out writer/writer
+//! races. It says nothing about the *reader*: the flush could still
+//!
+//! * read a slot whose writer was admitted but had not stored yet (reading
+//!   the zero-initialized placeholder instead of the record), or
+//! * read a slot concurrently with a store in flight — a plain read racing a
+//!   plain write is undefined behaviour even when the locations are
+//!   "different from the writer's point of view".
+//!
+//! The admission gate below is what makes the read side safe: the flush
+//! closes admission, waits for every admitted writer to finish, and only
+//! then reads. Publication is carried by the gate's release/acquire RMW
+//! chain, not by the index arithmetic.
+//!
+//! # Interleavings this design handles (each has a test at the bottom)
+//!
+//! * **Writer paused before admission.** After `close_gate`, `try_admit`
+//!   observes `CLOSED` and returns `None` (counted in `rejected_closed`).
+//!   The writer can never enter after the flush has drained.
+//! * **Writer admitted but paused before its slot store.** Its admission
+//!   keeps the count non-zero, so `drain` cannot return; the flush cannot
+//!   observe the slot in between. Dropping the guard without pushing (e.g.
+//!   the caller panics while building the record) releases the admission
+//!   without claiming a slot, so no claim ever lacks a store.
+//! * **Flush starting concurrently with admission.** The closed bit and the
+//!   admission count live in one atomic, so the writer's CAS and the
+//!   flush's `fetch_or` are totally ordered on it: either the writer is
+//!   counted (flush waits) or its CAS fails (writer rejected).
+//! * **Writer arriving after recording closed.** Rejected and counted;
+//!   `total_seen` deliberately excludes it, so
+//!   `total_seen + rejected_closed` is every attempted event.
+//! * **Ring at capacity.** The claim still counts in `total_seen` but no
+//!   slot is touched: `stored = min(total_seen, N)` and
+//!   `rejected_capacity = total_seen - stored` are exact by construction.
+//! * **No records.** The snapshot reports zeros and zero records.
+//! * **Repeated flush.** The gate stays closed forever after the first
+//!   close; later `close` calls re-snapshot the same frozen records with a
+//!   possibly larger `rejected_closed`. Records never change once stored.
+//!
+//! # Memory ordering
+//!
+//! Every gate operation (`try_admit` CAS, guard drop, `close_gate`) is an
+//! `AcqRel` read-modify-write on the single `gate` atomic; `drain` spins on
+//! `Acquire` loads. RMWs read the immediately preceding value in the
+//! atomic's modification order, so the acquire/release pairs chain along
+//! that order: the final `Acquire` load that observes a zero count
+//! synchronizes with the last decrement, which acquired the one before it,
+//! and so transitively with every admitted writer's slot store. The flush's
+//! subsequent plain reads therefore cannot race a writer store, and every
+//! slot below `stored` holds its completed record. No `&mut` or `&` to the
+//! whole buffer is ever materialized: slot access goes through raw pointer
+//! arithmetic from [`UnsafeCell::get`].
+//!
+//! `close` must never be called while holding one of this ring's own
+//! admissions (it would wait for itself); `flush_to_env` does not.
+
+use std::cell::UnsafeCell;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// Records per ring (2^20 x 40 B = 40 MiB), doubled from 2^19 when the
+/// inner-boundary markers were added.
+pub(crate) const CAPACITY: usize = 1 << 20;
+
+/// One probe record; serialized little-endian with the layout
+/// `kind:u8, reserved:u8, pad:u16, step:u32, tid:u32, reserved2:u32,
+/// id:u64, ts:u64, a:u64` (40 bytes).
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Record {
+    /// Record kind (`KIND_*` in `fs_probe`).
+    pub(crate) kind: u8,
+    /// Reserved, always zero.
+    pub(crate) reserved: u8,
+    /// Padding, always zero.
+    pub(crate) pad: u16,
+    /// Step tag hash (`a` payload for quorum sends: `results_seen`).
+    pub(crate) step: u32,
+    /// Recording thread's OS tid.
+    pub(crate) tid: u32,
+    /// Reserved, zero except on quorum sends (fanout `disk_count`).
+    pub(crate) reserved2: u32,
+    /// Blocking-job id (`write_quorum` for quorum sends).
+    pub(crate) id: u64,
+    /// `CLOCK_MONOTONIC` nanoseconds at record time.
+    pub(crate) ts: u64,
+    /// Operation hash (or thread CPU ns on job start/end).
+    pub(crate) a: u64,
+}
+
+impl Record {
+    /// Static placeholder for every slot before it is claimed and stored.
+    pub(crate) const ZERO: Record = Record {
+        kind: 0,
+        reserved: 0,
+        pad: 0,
+        step: 0,
+        tid: 0,
+        reserved2: 0,
+        id: 0,
+        ts: 0,
+        a: 0,
+    };
+}
+
+/// Result of one admitted push. A push rejected *before* admission is not
+/// a [`PushOutcome`]: it is counted in [`Snapshot::rejected_closed`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum PushOutcome {
+    /// The record was stored to its claimed slot.
+    Stored,
+    /// The claim reached capacity; no slot was touched.
+    RejectedCapacity,
+}
+
+/// Counters taken after (or independently of) a drain. Definitions:
+/// `total_seen` counts admitted slot claims while recording was open;
+/// `stored` = `min(total_seen, N)` records actually serialized;
+/// `rejected_capacity` = `total_seen - stored`; `rejected_closed` counts
+/// push attempts refused because recording was closed (excluded from
+/// `total_seen`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Snapshot {
+    /// Admitted slot claims while recording was open.
+    pub(crate) total_seen: u64,
+    /// Records actually stored (`min(total_seen, N)`).
+    pub(crate) stored: u64,
+    /// Claims refused because capacity was exhausted.
+    pub(crate) rejected_capacity: u64,
+    /// Push attempts refused because recording was closed.
+    pub(crate) rejected_closed: u64,
+}
+
+const CLOSED: u64 = 1 << 63;
+const ADMITTED_MASK: u64 = CLOSED - 1;
+
+/// The shared ring: slot storage plus the flush admission gate.
+///
+/// # Safety invariants (what `unsafe impl Sync` rests on)
+///
+/// 1. **Unique claims.** `write.fetch_add` hands out each index once;
+///    claims `>= N` are rejected without touching storage, and the ring
+///    never wraps, so at most one thread ever stores to a given slot.
+/// 2. **Store only while admitted.** A slot store happens only between a
+///    successful `try_admit` and that guard's drop (see [`RecordWriter`]),
+///    so while the admission count is non-zero a writer may still be
+///    mid-record.
+/// 3. **Read only after drain.** Reads ([`ProbeRing::record`]) are only
+///    called after `close_gate` + `drain` returned, which establishes —
+///    via the `Acquire` load observing a zero count in the `AcqRel` RMW
+///    chain — that every admitted writer's store happens-before the read,
+///    and that no writer can start a new store afterwards.
+/// 4. **No whole-buffer references.** Both sides use raw pointer
+///    arithmetic from `UnsafeCell::get`, so no `&mut [Record; N]` (which
+///    would claim exclusive access to *every* slot) or shared reference to
+///    the buffer is ever created.
+/// 5. **Initialization.** Slots are zero-initialized static memory;
+///    slots `>= stored` are never read by the flush.
+pub(crate) struct ProbeRing<const N: usize> {
+    slots: UnsafeCell<[Record; N]>,
+    write: AtomicU64,
+    gate: AtomicU64,
+    rejected_closed: AtomicU64,
+}
+
+// SAFETY: see the invariant list on `ProbeRing`. Distinct indices alone
+// are NOT the argument — the admission gate (invariants 2 and 3) is what
+// excludes writer/reader races; the claim rules only exclude writer/
+// writer races.
+unsafe impl<const N: usize> Sync for ProbeRing<N> {}
+
+impl<const N: usize> ProbeRing<N> {
+    pub(crate) const fn new() -> Self {
+        Self {
+            slots: UnsafeCell::new([Record::ZERO; N]),
+            write: AtomicU64::new(0),
+            gate: AtomicU64::new(0),
+            rejected_closed: AtomicU64::new(0),
+        }
+    }
+
+    /// Try to enter the recording region. `None` means recording is
+    /// closed (a flush happened); the refusal is counted.
+    pub(crate) fn try_admit(&self) -> Option<RecordWriter<'_, N>> {
+        let mut current = self.gate.load(Ordering::Relaxed);
+        loop {
+            if current & CLOSED != 0 {
+                self.rejected_closed.fetch_add(1, Ordering::Relaxed);
+                return None;
+            }
+            // AcqRel keeps every gate RMW inside one synchronizes-with
+            // chain so `drain` needs no extra fences; the ordering that
+            // matters for the record itself is the guard's release.
+            match self.gate.compare_exchange_weak(
+                current,
+                current + 1,
+                Ordering::AcqRel,
+                Ordering::Relaxed,
+            ) {
+                Ok(_) => return Some(RecordWriter { ring: self }),
+                Err(observed) => current = observed,
+            }
+        }
+    }
+
+    fn release(&self) {
+        self.gate.fetch_sub(1, Ordering::AcqRel);
+    }
+
+    /// Close admission (idempotent; the gate stays closed afterwards).
+    pub(crate) fn close_gate(&self) {
+        self.gate.fetch_or(CLOSED, Ordering::AcqRel);
+    }
+
+    /// Wait until every admitted writer has dropped its guard. Safe to
+    /// call repeatedly; never call it while holding this ring's own
+    /// admission.
+    pub(crate) fn drain(&self) {
+        let mut spins: u64 = 0;
+        while self.gate.load(Ordering::Acquire) & ADMITTED_MASK != 0 {
+            spins += 1;
+            if spins % 1024 == 0 {
+                std::thread::yield_now();
+            } else {
+                std::hint::spin_loop();
+            }
+        }
+    }
+
+    /// Close admission, drain every writer, snapshot the counters.
+    pub(crate) fn close(&self) -> Snapshot {
+        self.close_gate();
+        self.drain();
+        self.snapshot()
+    }
+
+    /// Read the counters without closing. Callers that must observe a
+    /// frozen ring need `close` (or `close_gate` + `drain`) first.
+    pub(crate) fn snapshot(&self) -> Snapshot {
+        // Acquire pairs with the AcqRel gate RMWs when a drain happened;
+        // with no concurrent writers (single-threaded tests) any order
+        // reads the latest value.
+        let total_seen = self.write.load(Ordering::Acquire);
+        let stored = total_seen.min(N as u64);
+        Snapshot {
+            total_seen,
+            stored,
+            rejected_capacity: total_seen - stored,
+            rejected_closed: self.rejected_closed.load(Ordering::Relaxed),
+        }
+    }
+
+    /// Read one stored record. Caller contract: called only after
+    /// `close_gate` + `drain`, with `index < snapshot.stored`.
+    pub(crate) fn record(&self, index: u64) -> Record {
+        debug_assert!(index < N as u64);
+        // SAFETY: index < N (checked above), and invariant 3 gives no
+        // concurrent writer: raw arithmetic, no reference to the buffer.
+        let base = self.slots.get() as *mut Record;
+        unsafe { base.add(index as usize).read() }
+    }
+}
+
+/// Admission guard: while alive, `drain` cannot complete. Consumed by
+/// [`RecordWriter::push`], or released on drop (caller panic, unused).
+pub(crate) struct RecordWriter<'a, const N: usize> {
+    ring: &'a ProbeRing<N>,
+}
+
+impl<const N: usize> RecordWriter<'_, N> {
+    /// Claim a slot and store the record. Between the claim and the
+    /// store runs no caller-provided code, so a claim can never be
+    /// abandoned half-done. Dropping the guard (also on the early
+    /// capacity return) releases the admission with `AcqRel`, publishing
+    /// the store to any draining flush.
+    pub(crate) fn push(self, record: Record) -> PushOutcome {
+        let index = self.ring.write.fetch_add(1, Ordering::Relaxed);
+        if index >= N as u64 {
+            // Capacity reached: stop recording rather than wrap onto a
+            // slot a descheduled writer may still store to. The claim is
+            // counted, so `rejected_capacity` reports it exactly.
+            return PushOutcome::RejectedCapacity;
+        }
+        // SAFETY: invariants 1 (unique claim), 2 (store while admitted),
+        // 4 (raw pointer arithmetic from UnsafeCell::get, no reference
+        // to the whole array). The flush cannot read this slot until the
+        // guard's release below is observed by its draining acquire.
+        let base = self.ring.slots.get() as *mut Record;
+        unsafe { base.add(index as usize).write(record) };
+        PushOutcome::Stored
+    }
+}
+
+impl<const N: usize> Drop for RecordWriter<'_, N> {
+    fn drop(&mut self) {
+        self.ring.release();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::mpsc;
+    use std::thread;
+
+    /// Distinct, self-consistent record: a torn or zero-filled read shows
+    /// up as a violated cross-field relation (`a == ts * 7`).
+    fn rec(kind: u8, id: u64, ts: u64) -> Record {
+        Record {
+            kind,
+            reserved: 0,
+            pad: 0,
+            step: 0xC0FFEE,
+            tid: 99,
+            reserved2: 0,
+            id,
+            ts,
+            a: ts * 7,
+        }
+    }
+
+    fn push_ok(ring: &ProbeRing<8>, kind: u8, id: u64, ts: u64) -> PushOutcome {
+        ring.try_admit()
+            .expect("gate open")
+            .push(rec(kind, id, ts))
+    }
+
+    #[test]
+    fn no_records_snapshot_reports_zeros() {
+        let ring = ProbeRing::<8>::new();
+        let snap = ring.close();
+        assert_eq!(
+            snap,
+            Snapshot {
+                total_seen: 0,
+                stored: 0,
+                rejected_capacity: 0,
+                rejected_closed: 0,
+            }
+        );
+    }
+
+    #[test]
+    fn capacity_stops_storing_and_counts_the_refusals_exactly() {
+        let ring = ProbeRing::<8>::new();
+        let mut stored = 0;
+        for ts in 0..12u64 {
+            if push_ok(&ring, 7, 1, ts) == PushOutcome::Stored {
+                stored += 1;
+            }
+        }
+        let snap = ring.close();
+        assert_eq!(stored, 8);
+        assert_eq!(
+            snap,
+            Snapshot {
+                total_seen: 12,
+                stored: 8,
+                rejected_capacity: 4,
+                rejected_closed: 0,
+            }
+        );
+        // First claims win; every stored slot is complete.
+        for (i, ts) in (0..8u64).enumerate() {
+            assert_eq!(ring.record(i as u64), rec(7, 1, ts));
+        }
+    }
+
+    #[test]
+    fn flush_rejects_a_writer_paused_before_admission() {
+        let ring = ProbeRing::<8>::new();
+        let ring = &ring; // shared by the scoped writer + this thread
+        let (ready_tx, ready_rx) = mpsc::channel();
+        let (go_tx, go_rx) = mpsc::channel();
+        thread::scope(|scope| {
+            let ready_tx = ready_tx.clone();
+            scope.spawn(move || {
+                // Writer arrives, pauses before admission, is released
+                // only after the flush has fully drained.
+                ready_tx.send(()).unwrap();
+                go_rx.recv().unwrap();
+                let admitted = ring.try_admit();
+                assert!(admitted.is_none(), "late writer must not be admitted");
+            });
+            ready_rx.recv().unwrap(); // writer is poised before admission
+            let snap = ring.close(); // close + drain (count already 0)
+            assert_eq!(snap.total_seen, 0);
+            go_tx.send(()).unwrap();
+        });
+        let snap = ring.snapshot();
+        assert_eq!(snap.total_seen, 0);
+        assert_eq!(snap.stored, 0);
+        assert_eq!(snap.rejected_closed, 1);
+    }
+
+    #[test]
+    fn drain_waits_for_an_admitted_writer_paused_before_its_store() {
+        let ring = ProbeRing::<8>::new();
+        let ring = &ring; // shared by the scoped flusher + this thread
+        let guard = ring.try_admit().expect("gate is open");
+        let (closed_tx, closed_rx) = mpsc::channel();
+        let (drained_tx, drained_rx) = mpsc::channel();
+        thread::scope(|scope| {
+            scope.spawn(move || {
+                ring.close_gate();
+                closed_tx.send(()).unwrap();
+                ring.drain();
+                drained_tx.send(()).unwrap();
+            });
+            closed_rx.recv().unwrap(); // gate closed; writer still admitted
+            // The flush must not complete while the admitted writer has
+            // not stored: bounded poll, no sleeps.
+            for _ in 0..1000 {
+                if drained_rx.try_recv().is_ok() {
+                    panic!("drain completed while an admitted writer had not stored");
+                }
+                thread::yield_now();
+            }
+            guard.push(rec(9, 5, 42)); // store, then release publishes it
+            drained_rx.recv().unwrap(); // drain completes only now
+        });
+        let snap = ring.close();
+        assert_eq!(snap.total_seen, 1);
+        assert_eq!(snap.stored, 1);
+        // A flush racing the store window sees the complete record — or
+        // nothing — never a partial one.
+        assert_eq!(ring.record(0), rec(9, 5, 42));
+    }
+
+    #[test]
+    fn a_late_writer_cannot_mutate_the_frozen_snapshot() {
+        let ring = ProbeRing::<8>::new();
+        push_ok(&ring, 7, 1, 10);
+        let frozen = ring.close();
+        let before: Vec<Record> = (0..frozen.stored)
+            .map(|index| ring.record(index))
+            .collect();
+        // Every subsequent push attempt is refused before admission.
+        for _ in 0..4 {
+            assert!(ring.try_admit().is_none());
+        }
+        let after: Vec<Record> = (0..frozen.stored)
+            .map(|index| ring.record(index))
+            .collect();
+        assert_eq!(before, after);
+        let snap = ring.snapshot();
+        assert_eq!(snap.total_seen, frozen.total_seen);
+        assert_eq!(snap.stored, frozen.stored);
+        assert_eq!(snap.rejected_closed, 4);
+    }
+
+    #[test]
+    fn repeated_flushes_are_predictable() {
+        let ring = ProbeRing::<8>::new();
+        push_ok(&ring, 7, 1, 1);
+        let first = ring.close();
+        // Late events between flushes only grow the rejection counter.
+        assert!(ring.try_admit().is_none());
+        assert!(ring.try_admit().is_none());
+        let second = ring.close(); // close is idempotent, records frozen
+        assert_eq!(first.total_seen, second.total_seen);
+        assert_eq!(first.stored, second.stored);
+        assert_eq!(second.rejected_closed, first.rejected_closed + 2);
+        assert_eq!(ring.record(0), rec(7, 1, 1));
+    }
+
+    #[test]
+    fn a_guard_dropped_without_pushing_releases_its_admission() {
+        let ring = ProbeRing::<8>::new();
+        // Caller panics between admission and push (record construction):
+        // the guard's drop must release the count, or flush would hang.
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let guard = ring.try_admit().expect("gate open");
+            let _ = &guard;
+            panic!("record construction failed");
+        }));
+        assert!(result.is_err());
+        let snap = ring.close(); // completes: count was released
+        assert_eq!(snap.total_seen, 0);
+        assert_eq!(snap.stored, 0);
+    }
+
+    #[test]
+    fn concurrent_writers_racing_a_flush_stay_consistent() {
+        const N: usize = 64;
+        const WRITERS: u64 = 4;
+        const PER_WRITER: u64 = 5_000;
+        let ring = ProbeRing::<N>::new();
+        let ring = &ring; // shared by the scoped writers/flusher + this thread
+        // All writers and the flusher are released on one barrier, so the
+        // close genuinely races the pushes (no sleeps involved).
+        let start = std::sync::Barrier::new(WRITERS as usize + 1);
+        let start = &start;
+        let refused = thread::scope(|scope| {
+            let flusher = scope.spawn(move || {
+                start.wait();
+                ring.close_gate();
+                ring.drain();
+            });
+            let writers: Vec<_> = (0..WRITERS)
+                .map(|writer| {
+                    scope.spawn(move || {
+                        start.wait();
+                        let mut refused = 0u64;
+                        for seq in 0..PER_WRITER {
+                            match ring.try_admit() {
+                                Some(guard) => {
+                                    if guard.push(rec(9, writer, seq))
+                                        == PushOutcome::RejectedCapacity
+                                    {
+                                        refused += 1;
+                                    }
+                                }
+                                None => refused += 1,
+                            }
+                        }
+                        refused
+                    })
+                })
+                .collect();
+            flusher.join().expect("flusher thread");
+            writers.into_iter().map(|w| w.join().unwrap()).sum::<u64>()
+        });
+        // Snapshotted only after every writer finished, so the counters
+        // cover every attempt of the run.
+        let snap = ring.snapshot();
+        // Every attempt is accounted exactly once: admitted claims in
+        // total_seen, post-close attempts in rejected_closed.
+        assert_eq!(
+            snap.total_seen + snap.rejected_closed,
+            WRITERS * PER_WRITER
+        );
+        assert_eq!(snap.stored, snap.total_seen.min(N as u64));
+        assert_eq!(snap.rejected_capacity, snap.total_seen - snap.stored);
+        // refused = capacity refusals (also inside rejected_capacity)
+        // + post-close refusals.
+        assert_eq!(refused, snap.rejected_capacity + snap.rejected_closed);
+        // Every stored slot holds one complete record: no zero placeholder
+        // (a claim published without its store) and no torn read.
+        for index in 0..snap.stored {
+            let record = ring.record(index);
+            assert_eq!(record.kind, 9, "placeholder read at {index}");
+            assert_eq!(record.step, 0xC0FFEE);
+            assert_eq!(record.tid, 99);
+            assert_eq!(record.a, record.ts * 7, "torn record at {index}");
+            assert!(record.id < WRITERS);
+            assert!(record.ts < PER_WRITER);
+        }
+    }
+}
diff -ruN a/src/fs_probe.rs b/src/fs_probe.rs
--- a/src/fs_probe.rs	1970-01-01 05:30:00.000000000 +0530
+++ b/src/fs_probe.rs	2026-10-09 04:07:16.437500955 +0530
@@ -0,0 +1,423 @@
+//! Diagnostic probe for blocking-pool job boundaries.
+//!
+//! Compiled only with `--cfg rustfs_fs_probe` (Linux only). Records raw
+//! `CLOCK_MONOTONIC` nanoseconds, the same clock Dial9 uses for trace
+//! timestamps, so probe records and Dial9 poll events share one time domain
+//! and join by containment on the OS thread id (`gettid`).
+//!
+//! Observed boundaries per blocking job, keyed by the Tokio task id:
+//!
+//! * `T0` `KIND_SUBMIT`      – recorded in `spawn_blocking_inner` immediately
+//!   before the job is pushed to the blocking pool queue; carries the `OP`
+//!   and `STEP` task-local context of the spawning task.
+//! * `T1` `KIND_JOB_START`   – recorded in `BlockingTask::poll` immediately
+//!   before the closure runs on a blocking thread.
+//! * `T2` `KIND_JOB_END`     – recorded immediately after the closure returns.
+//! * `T3'` `KIND_JOB_COMPLETE` – recorded after `task.run()` returns in the
+//!   blocking worker loop; the task harness has stored the output and woken
+//!   the join waker inside `run()`, so this is an upper bound on the instant
+//!   the result became available.
+//! * `T5` `KIND_JOIN_READY`  – recorded when `JoinHandle::poll` observes
+//!   `Ready` inside the awaiting task.
+//!
+//! Missing records stay missing: analysis reports incomplete intervals rather
+//! than fabricating zeros. Recording stops at ring capacity instead of
+//! wrapping (wrapping would race a descheduled writer's store), and
+//! `total_seen` keeps counting so records never stored stay visible.
+//!
+//! Ring safety: the record storage and its flush admission gate live in
+//! [`crate::fs_probe_ring`] — writers claim slots through an admission
+//! guard, and `flush_to_env` closes admission, drains every admitted
+//! writer (main runtime, the static `FSYNC_RUNTIME`, or any other probe
+//! writer — runtime shutdown order is *not* what makes it safe), and only
+//! then reads the ring. Events attempted after that close are refused and
+//! counted in the dump's `rejected_closed`.
+//!
+//! Dump format: version 2 = the original 64-byte header
+//! (`<8sIIQQQQIIQ>`) followed by a 24-byte extension
+//! (`stored:u64, rejected_capacity:u64, rejected_closed:u64`), then the
+//! 40-byte records. Version 1 (a fixed 64-byte header, no extension)
+//! dumps remain readable: `total_seen` means the same thing in both
+//! (slot claims while recording was open), and version 1 simply lacks the
+//! `rejected_closed` counter, which readers must report as missing rather
+//! than as zero.
+//!
+//! Runtime gate: records are written only when `RUSTFS_FS_PROBE_OUT` is set
+//! to a non-empty path. `flush_to_env` snapshots the buffer there; it
+//! closes recording, so it is a terminal snapshot (calling it again
+//! re-serializes the same frozen records with an updated
+//! `rejected_closed`).
+
+use std::cell::Cell;
+use std::future::Future;
+use std::sync::OnceLock;
+
+use crate::fs_probe_ring::{ProbeRing, Record, CAPACITY};
+
+/// Sentinel for "no operation context" in the `a` field of `T0` records.
+pub const OP_NONE: u64 = 0;
+
+pub const KIND_SUBMIT: u8 = 1;
+pub const KIND_JOB_START: u8 = 2;
+pub const KIND_JOB_END: u8 = 3;
+pub const KIND_JOB_COMPLETE: u8 = 4;
+pub const KIND_JOIN_READY: u8 = 5;
+/// Inner boundary inside a running blocking closure (`id` = job id, `step` =
+/// sub-tag hash). Recorded only when `RUSTFS_FS_PROBE_SUB` is set, because it
+/// multiplies record volume.
+pub const KIND_SUB: u8 = 6;
+pub const KIND_OP_BEGIN: u8 = 10;
+pub const KIND_OP_END: u8 = 11;
+pub const KIND_WAIT_BEGIN: u8 = 12;
+pub const KIND_WAIT_END: u8 = 13;
+pub const KIND_SEND_OK: u8 = 14;
+pub const KIND_SEND_ERR: u8 = 15;
+
+// The keys are built directly instead of with `task_local!` because that
+// macro cannot be invoked by absolute path from inside the defining crate.
+/// Operation context (`op_hash`) of the enclosing application operation.
+pub static OP: crate::task::LocalKey<u64> = {
+    std::thread_local! {
+        static PROBE_OP: std::cell::RefCell<Option<u64>> = const { std::cell::RefCell::new(None) };
+    }
+    crate::task::LocalKey { inner: PROBE_OP }
+};
+
+/// Call-site tag hash of the enclosing filesystem await.
+pub static STEP: crate::task::LocalKey<u32> = {
+    std::thread_local! {
+        static PROBE_STEP: std::cell::RefCell<Option<u32>> = const { std::cell::RefCell::new(None) };
+    }
+    crate::task::LocalKey { inner: PROBE_STEP }
+};
+
+/// FNV-1a (64-bit) over `bucket/object`, with the `OP_NONE` sentinel mapped
+/// to `1` so a real operation is never recorded as "unlinked". The analysis
+/// script recomputes the same function to join probe records with OTLP spans.
+pub fn op_hash(bucket: &str, object: &str) -> u64 {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    for bytes in [bucket.as_bytes(), b"/", object.as_bytes()] {
+        for &byte in bytes {
+            hash ^= u64::from(byte);
+            hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+    }
+    if hash == OP_NONE { 1 } else { hash }
+}
+
+fn step_hash(tag: &str) -> u32 {
+    let mut hash: u32 = 0x811c_9dc5;
+    for &byte in tag.as_bytes() {
+        hash ^= u32::from(byte);
+        hash = hash.wrapping_mul(0x0100_0193);
+    }
+    if hash == 0 { 1 } else { hash }
+}
+
+/// Tag the enclosing await's blocking jobs with a call-site name.
+pub fn scope_step<O>(tag: &'static str, future: impl Future<Output = O>) -> impl Future<Output = O> {
+    STEP.scope(step_hash(tag), future)
+}
+
+/// Synchronous variant of [`scope_step`] for call sites that spawn from poll
+/// context (no future to wrap): the tag applies to `f`, so any `spawn_blocking`
+/// issued inside it is tagged on submit.
+pub fn scope_step_sync<T>(tag: &'static str, f: impl FnOnce() -> T) -> T {
+    STEP.sync_scope(step_hash(tag), f)
+}
+
+/// Propagate the caller's `OP` task-local into a freshly spawned task so that
+/// blocking jobs spawned inside it stay linked to the operation. Records with
+/// `OP_NONE` when spawned outside an operation scope.
+pub fn propagate_op<F: Future>(future: F) -> impl Future<Output = F::Output> {
+    let op = OP.try_get().unwrap_or(OP_NONE);
+    async move {
+        if op == OP_NONE {
+            future.await
+        } else {
+            OP.scope(op, future).await
+        }
+    }
+}
+
+/// Record an application-side event (`id` = 0; join via `OP`/time context).
+pub fn record(kind: u8, step: u32, a: u64) {
+    if !enabled() {
+        return;
+    }
+    push(kind, step, 0, a);
+}
+
+/// Record a quorum-gated send with its dependency snapshot: `step` =
+/// `results_seen` processed by the join loop, `id` = `write_quorum`, and
+/// `reserved2` = fanout `disk_count` (so the tail after the ack is derivable).
+/// `a` carries the operation hash, matching the other op-scoped records.
+pub fn record_quorum_send(kind: u8, results_seen: u32, write_quorum: u32, disk_count: u32, a: u64) {
+    if !enabled() {
+        return;
+    }
+    push_full(
+        kind,
+        results_seen,
+        disk_count,
+        u64::from(write_quorum),
+        a,
+    );
+}
+
+/// Marker inside a running blocking closure; pairs with the enclosing job's
+/// `id` so the analyzer can split closure wall time into sub-stages. No-op
+/// unless `RUSTFS_FS_PROBE_SUB` is set and the thread is inside a job.
+pub fn sub_step(tag: &'static str) {
+    if !sub_enabled() {
+        return;
+    }
+    let id = CURRENT_JOB.with(|current| current.get());
+    if id == 0 {
+        return;
+    }
+    push(KIND_SUB, step_hash(tag), id, 0);
+}
+
+pub(crate) fn spawn_submit(id: u64) {
+    if !enabled() {
+        return;
+    }
+    let op = OP.try_get().unwrap_or(OP_NONE);
+    let step = STEP.try_get().unwrap_or(0);
+    push(KIND_SUBMIT, step, id, op);
+}
+
+pub(crate) fn job_start(id: u64) {
+    if !enabled() {
+        return;
+    }
+    CURRENT_JOB.with(|current| current.set(id));
+    // `a` carries the thread CPU clock at entry so the analyzer can derive the
+    // closure's CPU time (wall time minus CPU = off-CPU wait). Captured on the
+    // same thread that runs `func()`.
+    push(KIND_JOB_START, 0, id, thread_cpu_ns());
+}
+
+pub(crate) fn job_end(id: u64) {
+    if !enabled() {
+        return;
+    }
+    push(KIND_JOB_END, 0, id, thread_cpu_ns());
+}
+
+pub(crate) fn job_complete() {
+    if !enabled() {
+        return;
+    }
+    let id = CURRENT_JOB.with(|current| current.replace(0));
+    if id != 0 {
+        push(KIND_JOB_COMPLETE, 0, id, 0);
+    }
+}
+
+pub(crate) fn join_ready(id: u64) {
+    if !enabled() {
+        return;
+    }
+    push(KIND_JOIN_READY, 0, id, 0);
+}
+
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("RUSTFS_FS_PROBE_OUT").is_some_and(|value| !value.is_empty()))
+}
+
+fn sub_enabled() -> bool {
+    static SUB_ENABLED: OnceLock<bool> = OnceLock::new();
+    *SUB_ENABLED.get_or_init(|| std::env::var_os("RUSTFS_FS_PROBE_SUB").is_some_and(|value| !value.is_empty()))
+}
+
+thread_local! {
+    static CURRENT_JOB: Cell<u64> = const { Cell::new(0) };
+    static TID: u32 = {
+        // SAFETY: `SYS_gettid` takes no arguments and always succeeds.
+        unsafe { libc::syscall(libc::SYS_gettid) as u32 }
+    };
+}
+
+fn tid() -> u32 {
+    TID.with(|value| *value)
+}
+
+/// Raw `CLOCK_MONOTONIC` nanoseconds; identical to Dial9's trace clock.
+fn now_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: `ts` is a valid out-pointer for `clock_gettime`.
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+/// Thread CPU time in nanoseconds (`CLOCK_THREAD_CPUTIME_ID`); read around a
+/// blocking closure so its off-CPU wait (kernel fsync/lock wait, descheduling)
+/// is `wall - (end - start)` of this clock.
+fn thread_cpu_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: `ts` is a valid out-pointer for `clock_gettime`.
+    unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut ts) };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+fn realtime_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: `ts` is a valid out-pointer for `clock_gettime`.
+    unsafe { libc::clock_gettime(libc::CLOCK_REALTIME, &mut ts) };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+/// The shared record ring. Static so every probe writer — main-runtime
+/// blocking pool, the static `FSYNC_RUNTIME`, worker loops, and the
+/// application-side `record()` call sites — reaches one instance; the
+/// admission gate in [`crate::fs_probe_ring`] is what makes its snapshot
+/// safe against all of them.
+static RING: ProbeRing<CAPACITY> = ProbeRing::new();
+
+fn push(kind: u8, step: u32, id: u64, a: u64) {
+    push_full(kind, step, 0, id, a);
+}
+
+fn push_full(kind: u8, step: u32, reserved2: u32, id: u64, a: u64) {
+    // Admission first: a push attempted after `flush_to_env` closed
+    // recording is refused *and counted* (inside `try_admit`) before it
+    // can claim a slot, so it can never enter a frozen snapshot.
+    let Some(writer) = RING.try_admit() else {
+        return;
+    };
+    // The record is built after admission but before the claim, so a
+    // failure anywhere in here releases the admission without leaving an
+    // unstored slot behind.
+    let record = Record {
+        kind,
+        reserved: 0,
+        pad: 0,
+        step,
+        tid: tid(),
+        reserved2,
+        id,
+        ts: now_ns(),
+        a,
+    };
+    writer.push(record);
+}
+
+fn put_u16(buffer: &mut Vec<u8>, value: u16) {
+    buffer.extend_from_slice(&value.to_le_bytes());
+}
+
+fn put_u32(buffer: &mut Vec<u8>, value: u32) {
+    buffer.extend_from_slice(&value.to_le_bytes());
+}
+
+fn put_u64(buffer: &mut Vec<u8>, value: u64) {
+    buffer.extend_from_slice(&value.to_le_bytes());
+}
+
+/// Write the ring buffer to `RUSTFS_FS_PROBE_OUT`.
+///
+/// Safe to call at any point in the process lifetime and repeatedly:
+/// it first closes record admission and drains every writer that was
+/// already admitted — the barrier does *not* rely on the runtimes having
+/// been shut down, so a still-live static `FSYNC_RUNTIME` cannot race the
+/// snapshot — then serializes version 2's header (64-byte base + the
+/// `stored` / `rejected_capacity` / `rejected_closed` extension) and the
+/// stored records. `total_seen` keeps records never stored beyond
+/// capacity visible; events refused after this close are visible as
+/// `rejected_closed` instead of silently vanishing. The gate stays
+/// closed afterwards, so later flushes re-serialize the same frozen
+/// records with an updated `rejected_closed`.
+pub fn flush_to_env() {
+    let Some(path) = std::env::var_os("RUSTFS_FS_PROBE_OUT") else {
+        return;
+    };
+    if path.is_empty() {
+        return;
+    }
+    // Close admission and drain every admitted writer BEFORE reading the
+    // ring: publication of each slot store is carried by the gate's
+    // AcqRel chain (see `fs_probe_ring`), not by runtime join order.
+    let snapshot = RING.close();
+    let monotonic_start = now_ns();
+    let realtime = realtime_ns();
+    let monotonic = monotonic_start + (now_ns() - monotonic_start) / 2;
+
+    let mut buffer: Vec<u8> =
+        Vec::with_capacity(64 + 24 + snapshot.stored as usize * std::mem::size_of::<Record>());
+    buffer.extend_from_slice(b"RFSPRB01");
+    // Version 2: the 64-byte version-1 layout below is unchanged, with a
+    // 24-byte counter extension appended after it (before the records).
+    put_u32(&mut buffer, 2);
+    put_u32(&mut buffer, std::mem::size_of::<Record>() as u32);
+    put_u64(&mut buffer, CAPACITY as u64);
+    put_u64(&mut buffer, snapshot.total_seen);
+    put_u64(&mut buffer, monotonic);
+    put_u64(&mut buffer, realtime);
+    put_u32(&mut buffer, libc::CLOCK_MONOTONIC as u32);
+    put_u32(&mut buffer, 0);
+    put_u64(&mut buffer, u64::from(std::process::id()));
+    put_u64(&mut buffer, snapshot.stored);
+    put_u64(&mut buffer, snapshot.rejected_capacity);
+    put_u64(&mut buffer, snapshot.rejected_closed);
+    for index in 0..snapshot.stored {
+        let record = RING.record(index);
+        buffer.push(record.kind);
+        buffer.push(record.reserved);
+        put_u16(&mut buffer, record.pad);
+        put_u32(&mut buffer, record.step);
+        put_u32(&mut buffer, record.tid);
+        put_u32(&mut buffer, record.reserved2);
+        put_u64(&mut buffer, record.id);
+        put_u64(&mut buffer, record.ts);
+        put_u64(&mut buffer, record.a);
+    }
+    if let Err(error) = std::fs::write(&path, &buffer) {
+        eprintln!("rustfs fs-probe flush to {:?} failed: {error}", std::path::Path::new(&path));
+    }
+}
+
+#[cfg(test)]
+mod step_hash_vectors {
+    use super::step_hash;
+
+    /// Same vectors as `experiments/rustfs/test_experiment.py`; the analyzer's
+    /// Python mirror of `step_hash` must agree with this implementation for
+    /// every tag name either side records.
+    #[test]
+    fn step_hashes_match_the_python_analyzer() {
+        for (tag, expected) in [
+            ("mkdir", 2883839448),
+            ("make_dir_all", 2398025995),
+            ("rename", 2180167635),
+            ("rename_no_owner", 3779027443),
+            ("dest_meta_read", 3173220776),
+            ("staged_meta_write", 1136281453),
+            ("src_dir_sync", 3702088569),
+            ("rename_data_dir", 3947226104),
+            ("rename_meta", 64001953),
+            ("dst_dir_fsync", 379138918),
+            ("ancestor_fsync", 2435288110),
+            ("sub_scan", 1830077803),
+            ("sub_prep_open", 2700932782),
+            ("sub_prep_write", 3442534505),
+            ("sub_fdatasync", 3828332939),
+            ("sub_fsync_files", 2779959459),
+            ("sub_dir_open", 605670494),
+            ("sub_dir_sync", 1793101661),
+            ("sub_rename", 3645352792),
+            ("sub_scan_end", 2660144945),
+            ("sub_prep_open_end", 1884947536),
+            ("sub_prep_write_end", 1276132143),
+            ("sub_fdatasync_end", 2941781905),
+            ("sub_fsync_files_end", 3871831177),
+            ("sub_dir_open_end", 169304928),
+            ("sub_dir_sync_end", 1067621507),
+            ("sub_rename_end", 3128992490),
+        ] {
+            assert_eq!(step_hash(tag), expected, "tag {tag}");
+        }
+    }
+}
